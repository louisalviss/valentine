{
  "version": "1.0",
  "updated_at": "2026-08-25",
  "purpose": "Canonical routing/context registry for the Valentine web showcase, comparison surfaces, reusable patterns, labs and primitives.",
  "canonical_host": "https://louisalviss.github.io/valentine/",
  "read_order": [
    "AGENTS.md",
    "docs/WEB-SHOWCASE-CONTEXT.md",
    "docs/site-registry.json",
    "web-motion-library/library.json",
    "web-motion-library/quality.json"
  ],
  "surfaces": {
    "hub": {
      "path": "/",
      "role": "Top-level navigation and orientation for the repository."
    },
    "showcase": {
      "path": "/web-motion-library/",
      "role": "Curated gallery of reusable motion/interaction patterns for personal and client work.",
      "catalog": "web-motion-library/library.json",
      "quality": "web-motion-library/quality.json",
      "gate": "web-motion-library/quality-gate.mjs"
    },
    "comparison": {
      "path": "/directions/flow-ab/",
      "role": "A-H design-direction comparator. Use this when choosing visual medium/art direction rather than a motion primitive.",
      "canonical_source": "directions/flow-ab/",
      "qa": "directions/flow-ab/qa/"
    },
    "patterns": {
      "path": "/patterns/",
      "role": "Canonical source of approved reusable site patterns. Detailed pattern metadata lives in web-motion-library/library.json."
    },
    "labs": {
      "path": "/labs/",
      "role": "Experiments, candidates and engine studies that are not automatically client-ready.",
      "known_labs": [
        "labs/motion-skill/",
        "labs/wow-engine/",
        "labs/visual-system/",
        "labs/orbital-shrine/",
        "labs/scroll-3d/",
        "labs/umbra-editorial/",
        "labs/prmpt/"
      ]
    },
    "primitives": {
      "path": "/primitives/",
      "role": "Reusable implementation modules extracted from patterns/labs after reuse is proven.",
      "known": ["primitives/visual/reactive-field.js"]
    },
    "archive": {
      "path": "/archive/",
      "role": "Historical material outside the active design surface. Git history remains the primary archive."
    }
  },
  "canonical_patterns": [
    {"id":"aura-scroll-product-story","path":"patterns/aura-eclipse/","label":"AURA / Scroll Product Story"},
    {"id":"iris-operated-object","path":"patterns/mechanical-iris/","label":"IRIS / Operated Object"},
    {"id":"castle-exploded-assembly","path":"patterns/castle-assembly/","label":"Castle / Exploded Assembly Story"},
    {"id":"aurel-layer-build","path":"patterns/aurel-build/","label":"AUREL / Layer Build Story"},
    {"id":"mira-processing-pipeline","path":"patterns/mira-ai-motion/","label":"Mira / Processing Pipeline"},
    {"id":"signal-continuous-world","path":"patterns/signal-story/","label":"Signal / Continuous World Journey"},
    {"id":"living-atlas-explorer","path":"patterns/living-atlas/","label":"Living Atlas / Interactive Explorer"},
    {"id":"last-house-cinematic-timeline","path":"patterns/last-house-cinematic/","label":"Last House / Cinematic Timeline"},
    {"id":"vanta-editorial-object","path":"patterns/vanta-editorial/","label":"VANTA / Editorial Object Story"},
    {"id":"sword-object-viewer","path":"patterns/sword-3d/","label":"Sword / 3D Object Viewer"},
    {"id":"nocturne-hold-awaken","path":"patterns/nocturne/","label":"Nocturne / Hold-to-Awaken Object"},
    {"id":"vokie-process-machine","path":"patterns/vokie-process-machine/","label":"Vokie / Process Machine Story"},
    {"id":"preflight-interactive-checker","path":"patterns/preflight/","label":"Preflight / Interactive Product Checker"},
    {"id":"kaizen-frame-sequence","path":"patterns/kaizen/","label":"KAIZEN / Frame-Sequence Product"}
  ],
  "intent_routing": {
    "site showcase": "web-motion-library/",
    "web showcase": "web-motion-library/",
    "motion library": "web-motion-library/",
    "site so sanh": "directions/flow-ab/",
    "compare site": "directions/flow-ab/",
    "A-H": "directions/flow-ab/",
    "site mau": "patterns/ + web-motion-library/library.json",
    "pattern": "patterns/ + web-motion-library/library.json",
    "demo client": "web-motion-library/library.json + web-motion-library/quality.json",
    "lab": "labs/",
    "primitive": "primitives/"
  },
  "rules": [
    "Do not duplicate detailed pattern metadata here; library.json is authoritative for pattern catalog data.",
    "quality.json is authoritative for score/readiness and client-ready decisions.",
    "Root-level legacy demo folders are compatibility redirects, not canonical sources.",
    "Use directions/flow-ab for art-direction comparison; use web-motion-library for reusable interaction-pattern selection.",
    "For client work, prefer patterns whose derived quality state is client-ready; unresolved debt must be carried into the build brief."
  ]
}
